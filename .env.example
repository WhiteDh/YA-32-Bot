# Copy to .env and fill in. Names only here — real values never go into git.

# Token of the schedule bot from @BotFather (the same bot as before).
BOT_TOKEN=
# Telegram ids that are always owners, comma-separated (find yours via @userinfobot).
OWNER_IDS=

# Local default is SQLite (no Docker needed). With `scripts\dev.bat infra`:
#   DATABASE_URL=postgresql+asyncpg://ya32:ya32@localhost:5432/ya32
DATABASE_URL=sqlite+aiosqlite:///./data/ya32.db

TZ=Europe/Kyiv
LOG_LEVEL=INFO
RICH_MESSAGES=true

# schedule.kpi.ua group (https://schedule.kpi.ua/?groupId=3655)
KPI_GROUP_ID=3655
KPI_AUTOSYNC=true
KPI_SYNC_HOUR=6
